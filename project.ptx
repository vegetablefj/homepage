    <target name="note-nagata" format="html" source="notes/nagata/nagata.ptx" publication="nagata.ptx" output-dir="notes/nagata" xsl="note-html.xsl"/>
    <target name="note-cubic-fourfolds" format="html" source="notes/cubic-fourfolds/cubic-fourfolds.ptx" publication="cubic-fourfolds.ptx" output-dir="notes/cubic-fourfolds" xsl="note-html.xsl"/>
    <target name="note-category-theory" format="html" source="notes/category-theory/category-theory.ptx" publication="category-theory.ptx" output-dir="notes/category-theory" xsl="note-html.xsl"/>
  </targets>
