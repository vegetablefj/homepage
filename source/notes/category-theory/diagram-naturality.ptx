<?xml version="1.0" encoding="UTF-8"?>
<figure xml:id="cat-diagram-naturality">
  <caption>Naturality requires this square to commute for every morphism <m>f:X\to Y</m>.</caption>
  <image xml:id="cat-image-naturality" width="34%">
    <latex-image>
\begin{tikzcd}[row sep=large, column sep=large]
  F(X) \arrow[r, "F(f)"] \arrow[d, "\eta_X"'] \amp
  F(Y) \arrow[d, "\eta_Y"] \\
  G(X) \arrow[r, "G(f)"'] \amp G(Y)
\end{tikzcd}
    </latex-image>
    <description>A commutative square with F(X) and F(Y) above G(X) and G(Y). The horizontal arrows are F(f) and G(f), and the vertical arrows are eta_X and eta_Y.</description>
  </image>
</figure>
