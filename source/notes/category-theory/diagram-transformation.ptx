<?xml version="1.0" encoding="UTF-8"?>
<figure xml:id="cat-diagram-transformation">
  <caption>A natural transformation <m>\eta:F\Rightarrow G</m> is drawn between two parallel functors.</caption>
  <image xml:id="cat-image-transformation" width="28%">
    <latex-image>
\begin{tikzcd}[column sep=huge]
  \mathcal C
    \arrow[r, bend left=45, "F", ""{name=upper, below}]
    \arrow[r, bend right=45, "G"', ""{name=lower, above}]
  \amp \mathcal D
  \arrow[Rightarrow, from=upper, to=lower, "\eta"]
\end{tikzcd}
    </latex-image>
    <description>Two curved arrows F and G run from category C to category D. A double arrow labelled eta points from the upper arrow F to the lower arrow G.</description>
  </image>
</figure>
