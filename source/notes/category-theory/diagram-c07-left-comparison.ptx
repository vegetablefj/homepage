<?xml version='1.0' encoding='UTF-8'?>
<figure xml:id="cat-c07-fig-left-comparison">
  <caption>The defining square for the universal comparison, for each <m>t:ua\to b</m>.</caption>
  <image xml:id="cat-c07-image-left-comparison" width="34%">
    <description><p>A commutative square has Fa at the upper left, Lb at the upper right, H(ua) at the lower left, and Hb at the lower right. The top arrow is the colimit structure map lambda indexed by a and t. The left arrow is alpha at a, the bottom arrow is H of t, and the right arrow is the uniquely determined beta at b.</p></description>
    <latex-image>
\begin{tikzcd}[ampersand replacement=\amp, column sep=large, row sep=large]
F(a) \arrow[r, "\lambda^b_{a,t}"] \arrow[d, "\alpha_a"'] \amp L(b) \arrow[d, dashed, "\beta_b"] \\
H(ua) \arrow[r, "H(t)"'] \amp H(b)
\end{tikzcd}
    </latex-image>
  </image>
</figure>