<?xml version='1.0' encoding='UTF-8'?>
<figure xml:id="cat-c02-fig-comma">
  <caption>A morphism in <m>(F\downarrow G)</m> compares both endpoints and preserves the structure arrow.</caption>
  <image xml:id="cat-c02-image-comma" width="40%">
    <latex-image>
\begin{tikzcd}[row sep=large, column sep=large]
  F(A) \arrow[r, "u"] \arrow[d, "F(a)"'] \amp
  G(B) \arrow[d, "G(b)"] \\
  F(A') \arrow[r, "u'"'] \amp G(B')
\end{tikzcd}
    </latex-image>
    <description><p>A commutative square with F(A) and G(B) on the top row and F(A prime) and G(B prime) below. The horizontal arrows are u and u prime; the vertical arrows are F(a) and G(b).</p></description>
  </image>
</figure>