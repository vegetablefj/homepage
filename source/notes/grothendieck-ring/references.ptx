<?xml version="1.0" encoding="UTF-8"?>
<references xml:id="grv-references">
  <title>References</title>
  <biblio xml:id="grv-bib-CLNS" label="CLNS18" type="raw">Antoine Chambert-Loir, Johannes Nicaise, and Julien Sebag, <title>Motivic Integration</title>, Progress in Mathematics 325, Birkhäuser, 2018. <url href="https://doi.org/10.1007/978-1-4939-7887-8">Publisher</url>. Chapter 2 is the principal general reference for the Grothendieck ring and its realizations.</biblio>
  <biblio xml:id="grv-bib-Mustata" label="Mus11" type="raw">Mircea Mustaţă, <title>Zeta functions in algebraic geometry</title>, notes from a 2011 graduate course. <url href="https://websites.umich.edu/~mmustata/zeta_book.pdf">Author's notes</url>. Locators refer to the combined text: Propositions 7.31–7.32, Theorem 7.33, and Section 7.4. The rational-point hypothesis in Theorem 7.33 corrects the earlier separate Lecture 8.</biblio>
  <biblio xml:id="grv-bib-Bittner" label="Bit04" type="raw">Franziska Bittner, <title>The universal Euler characteristic for varieties of characteristic zero</title>, Compositio Mathematica 140 (2004), no. 4, 1011–1032. <url href="https://doi.org/10.1112/S0010437X03000617">DOI</url>; <url href="https://arxiv.org/abs/math/0111062">preprint</url>. Theorem 3.1 gives the presentation, Corollary 3.4 gives the duality involution, and Corollary 4.3 concerns the motivic Euler characteristic.</biblio>
  <biblio xml:id="grv-bib-LL03" label="LL03" type="raw">Michael Larsen and Valery A. Lunts, <title>Motivic measures and stable birational geometry</title>, Moscow Mathematical Journal 3 (2003), no. 1, 85–95. <url href="https://doi.org/10.17323/1609-4514-2003-3-1-85-95">DOI</url>; <url href="https://arxiv.org/abs/math/0110255">preprint</url>. Stable birational measures and the first irrationality results.</biblio>
  <biblio xml:id="grv-bib-LL04" label="LL04" type="raw">Michael Larsen and Valery A. Lunts, <title>Rationality criteria for motivic zeta functions</title>, Compositio Mathematica 140 (2004), no. 6, 1537–1560. <url href="https://doi.org/10.1112/S0010437X04000764">DOI</url>; <url href="https://arxiv.org/abs/math/0212158">preprint</url>. Locators in these notes use the published numbering, including Example 4.10.</biblio>
  <biblio xml:id="grv-bib-LL18" label="LL20" type="raw">Michael Larsen and Valery A. Lunts, <title>Irrationality of motivic zeta functions</title>, Duke Mathematical Journal 169 (2020), no. 1, 1–30. <url href="https://doi.org/10.1215/00127094-2019-0035">DOI</url>; <url href="https://arxiv.org/abs/1802.03661">preprint</url>. The localized theorem used here is over <m>\Q</m>; the preprint locator is Theorem 7.1.</biblio>
  <biblio xml:id="grv-bib-LiuSebag" label="LS10" type="raw">Qing Liu and Julien Sebag, <title>The Grothendieck ring of varieties and piecewise isomorphisms</title>, Mathematische Zeitschrift 265 (2010), 321–342. <url href="https://doi.org/10.1007/s00209-009-0518-7">DOI</url>; <url href="https://www.math.u-bordeaux.fr/~qliu/articles/K0.pdf">author version</url>. Stable birational tests, algebraic independence, and non-Noetherianity.</biblio>
  <biblio xml:id="grv-bib-Poonen" label="Poo02" type="raw">Bjorn Poonen, <title>The Grothendieck ring of varieties is not a domain</title>, Mathematical Research Letters 9 (2002), no. 4, 493–498. <url href="https://math.mit.edu/~poonen/papers/grothendieck.pdf">Author PDF</url>. Lemmas 2 and 3 construct the abelian varieties; Section 4 supplies the characteristic-zero nonvanishing argument.</biblio>
  <biblio xml:id="grv-bib-Shioda" label="Shi77" type="raw">Tetsuji Shioda, <title>Some remarks on abelian varieties</title>, Journal of the Faculty of Science, University of Tokyo, Section IA, Mathematics 24 (1977), no. 1, 11–21. <url href="https://repository.dl.itc.u-tokyo.ac.jp/records/39716">University repository</url>. Background for failure of product cancellation among elliptic curves.</biblio>
  <biblio xml:id="grv-bib-ShinderSlides" label="Shi17" type="raw">Evgeny Shinder, <title>L-equivalence of K3 surfaces</title>, EDGE seminar slides, Edinburgh, 26 June 2017. <url href="https://webhomes.maths.ed.ac.uk/cheltsov/edge2017/pdf/shinder.pdf">Slides</url>. The discussion of zero divisors includes the elliptic-curve cancellation phenomenon; the lattice proof in these notes is explicit.</biblio>
  <biblio xml:id="grv-bib-Borisov" label="Bor18" type="raw">Lev A. Borisov, <title>The class of the affine line is a zero divisor in the Grothendieck ring</title>, Journal of Algebraic Geometry 27 (2018), no. 2, 203–209. <url href="https://doi.org/10.1090/jag/701">DOI</url>; <url href="https://arxiv.org/abs/1412.6194">preprint</url>. The preprint first appeared in 2014.</biblio>
  <biblio xml:id="grv-bib-IMOU" label="IMOU19" type="raw">Atsushi Ito, Makoto Miura, Shinnosuke Okawa, and Kazushi Ueda, <title>The class of the affine line is a zero divisor in the Grothendieck ring: via <m>G_2</m>-Grassmannians</title>, Journal of Algebraic Geometry 28 (2019), no. 2, 245–250. <url href="https://doi.org/10.1090/jag/731">DOI</url>; <url href="https://arxiv.org/abs/1606.04210">preprint, v2</url>. Theorems 1.1 and 1.3 and Section 2 are used together.</biblio>
  <biblio xml:id="grv-bib-Ekedahl" label="Eke09" type="raw">Torsten Ekedahl, <title>The Grothendieck group of algebraic stacks</title>, arXiv:0903.3143v2, 2009. <url href="https://arxiv.org/abs/0903.3143">Preprint</url>. Section 3 constructs the Picard realization; Corollary 3.5 proves localized nonvanishing of Poonen's factors.</biblio>
  <biblio xml:id="grv-bib-Zakharevich" label="Zak17" type="raw">Inna Zakharevich, <title>The annihilator of the Lefschetz motive</title>, Duke Mathematical Journal 166 (2017), no. 11, 1989–2022. <url href="https://doi.org/10.1215/00127094-0000016X">DOI</url>; <url href="https://arxiv.org/abs/1506.06200">preprint</url>. A spectral-sequence approach to the annihilator and dimension filtration.</biblio>
  <biblio xml:id="grv-bib-KS" label="KS18" type="raw">Alexander Kuznetsov and Evgeny Shinder, <title>Grothendieck ring of varieties, D- and L-equivalence, and families of quadrics</title>, Selecta Mathematica (N.S.) 24 (2018), no. 4, 3475–3500. <url href="https://doi.org/10.1007/s00029-017-0344-4">DOI</url>; <url href="https://arxiv.org/abs/1612.07193">preprint</url>. Definition in Section 1.2, published Conjecture 1.6, and Theorem 1.9.</biblio>
  <biblio xml:id="grv-bib-Efimov" label="Efi18" type="raw">Alexander I. Efimov, <title>Some remarks on L-equivalence of algebraic varieties</title>, Selecta Mathematica (N.S.) 24 (2018), no. 4, 3753–3762. <url href="https://arxiv.org/abs/1707.08997">Preprint, v3, 14 November 2017</url>. Section 3 constructs the integral Hodge realization; Theorems 3.1, 3.2, and 3.4 give abelian-variety rigidity and the abelian and K3 finiteness statements.</biblio>
  <biblio xml:id="grv-bib-HassettLai" label="HL18" type="raw">Brendan Hassett and Kuan-Wen Lai, <title>Cremona transformations and derived equivalences of K3 surfaces</title>, Compositio Mathematica 154 (2018), no. 7, 1508–1533. <url href="https://doi.org/10.1112/S0010437X18007145">DOI</url>; <url href="https://kwlai-math.github.io/papers/2018-05_CremonaK3_mit-erratum.pdf">corrected author PDF</url>. The latter records the correction of 6 November 2018; Theorem 4.1 supplies the exponent-one relation.</biblio>
  <biblio xml:id="grv-bib-Meinsma" label="Mei26a" type="raw">Reinder Meinsma, <title>Counterexamples to the Kuznetsov–Shinder L-equivalence conjecture</title>, arXiv:2503.21511v3, 10 February 2026, to appear in Algebraic Geometry. <url href="https://arxiv.org/abs/2503.21511">Preprint</url>. Theorems 1.3/3.1 give the hyperkähler counterexamples; Conjecture 1.5 is cited in its v3 formulation.</biblio>
  <biblio xml:id="grv-bib-MeinsmaK3" label="Mei26b" type="raw">Reinder Meinsma, <title>On L-equivalence for K3 surfaces and hyperkähler manifolds</title>, Mathematische Zeitschrift 312 (2026), article 120. <url href="https://doi.org/10.1007/s00209-026-04013-8">DOI</url>; <url href="https://arxiv.org/abs/2408.17203v4">preprint, v4, 3 March 2026</url>. Theorems 1.2 and 4.2, Proposition 3.11, and Lemma 4.1.</biblio>
  <biblio xml:id="grv-bib-LinShinder" label="LS24" type="raw">Hsueh-Yung Lin and Evgeny Shinder, <title>Motivic invariants of birational maps</title>, Annals of Mathematics (2) 199 (2024), no. 1, 445–478. <url href="https://doi.org/10.4007/annals.2024.199.1.6">DOI</url>; <url href="https://arxiv.org/abs/2207.07389">preprint</url>. Proposition 2.10 and Remark 2.11 concern truncated Grothendieck groups.</biblio>
  <biblio xml:id="grv-bib-LSZ" label="LSZ23" type="raw">Hsueh-Yung Lin, Evgeny Shinder, and Susanna Zimmermann, <title>Factorization centers in dimension two and the Grothendieck ring of varieties</title>, Algebraic Geometry 10 (2023), no. 6, 666–693. <url href="https://doi.org/10.14231/AG-2023-024">DOI</url>; <url href="https://content.algebraicgeometry.nl/2023-6/2023-6-024.pdf">journal PDF</url>. Question 1.2 distinguishes piecewise isomorphism, rational points, and additive torsion.</biblio>
  <biblio xml:id="grv-bib-Kapranov" label="Kap00" type="raw">Mikhail Kapranov, <title>The elliptic curve in the S-duality theory and Eisenstein series for Kac–Moody groups</title>, arXiv:math/0001005, 2000. <url href="https://arxiv.org/abs/math/0001005">Preprint</url>. Section 1.3 introduces the motivic generating series; note the coefficient-ring convention when comparing it with later work.</biblio>
  <biblio xml:id="grv-bib-GuseinZade" label="GLM04" type="raw">S. M. Gusein-Zade, I. Luengo, and A. Melle-Hernández, <title>A power structure over the Grothendieck ring of varieties</title>, Mathematical Research Letters 11 (2004), no. 1, 49–57. <url href="https://doi.org/10.4310/MRL.2004.v11.n1.a6">DOI</url>; <url href="https://www.mat.ucm.es/~amelle/MRL-2004-Power-structure.pdf">author PDF</url>.</biblio>
  <biblio xml:id="grv-bib-MSS" label="MSS11" type="raw">Laurentiu Maxim, Morihiko Saito, and Jörg Schürmann, <title>Symmetric products of mixed Hodge modules</title>, Journal de Mathématiques Pures et Appliquées (9) 96 (2011), no. 5, 462–483. <url href="https://arxiv.org/abs/1008.5345">Preprint, v3, 3 December 2010</url>. Theorem 1 and Corollaries 1–3, with the compact-support extension stated in the introduction.</biblio>
  <biblio xml:id="grv-bib-Shein25" label="She25" type="raw">Vladimir Shein, <title>Singularities of symmetric powers and irrationality of motivic zeta functions</title>, arXiv:2508.15065v2, 27 October 2025. <url href="https://arxiv.org/abs/2508.15065">Preprint</url>. Theorems 1.2 and 1.4 and Remarks 3.10–3.11 are used with the rationality qualification explained in the text.</biblio>
  <biblio xml:id="grv-bib-Bot" label="BCvS25" type="raw">Anna Bot, Alessio Cangini, and Immanuel van Santen, <title>Does the Grothendieck ring of varieties contain nilpotent elements?</title>, arXiv:2509.10464. <url href="https://arxiv.org/abs/2509.10464">Preprint</url>. Its positive-characteristic nilpotence theorem concerns a related Bittner ring; the comparison with the usual ring must be retained.</biblio>
  <biblio xml:id="grm-bib-andre" label="And08" type="raw">Yves André, <title>An introduction to motivic zeta functions of motives</title>, arXiv:0812.3920, 2008. <url href="https://arxiv.org/abs/0812.3920">Preprint</url>. Sections 2.4–2.5 compare geometric and motive-valued zeta functions.</biblio>
  <biblio xml:id="grm-bib-gillet-soule" label="GS96" type="raw">Henri Gillet and Christophe Soulé, <title>Descent, motives and K-theory</title>, Journal für die reine und angewandte Mathematik 478 (1996), 127–176. <url href="https://arxiv.org/abs/alg-geom/9507013">Preprint</url>.</biblio>
  <biblio xml:id="grm-bib-scholl" label="Sch94" type="raw">A. J. Scholl, <title>Classical motives</title>, in <title>Motives</title>, Proceedings of Symposia in Pure Mathematics 55, Part 1, American Mathematical Society, 1994, 163–187. <url href="https://www.dpmms.cam.ac.uk/~ajs1005/preprints/classical_motives.pdf">Author's text</url>.</biblio>
  <biblio xml:id="grm-bib-tabuada" label="Tab19" type="raw">Gonçalo Tabuada, <title>Noncommutative motives in positive characteristic and their applications</title>, arXiv:1707.04248v4, 2019. <url href="https://arxiv.org/abs/1707.04248">Preprint</url>. Section 8 records the compact support triangle, the tensor property, and comparison with Chow motives.</biblio>
  <biblio xml:id="grm-bib-mvw" label="MVW06" type="raw">Carlo Mazza, Vladimir Voevodsky, and Charles Weibel, <title>Lecture Notes on Motivic Cohomology</title>, Clay Mathematics Monographs 2, American Mathematical Society and Clay Mathematics Institute, 2006. <url href="https://people.maths.ox.ac.uk/cmi/library/monographs/cmim02c.pdf">Book PDF</url>. Theorem 16.15 and Corollaries 16.16–16.17 treat compact supports under resolution; Proposition 20.1 and Remark 20.2 specify the opposite Chow category and the Lefschetz object in geometric motives.</biblio>
  <biblio xml:id="grf-bib-annala-satriano-sundbo" label="ASS26" type="raw">Toni Annala, Matthew Satriano, and Evan Sundbo, <title>Grothendieck ring of varieties and at-the-characteristic numerical invariants</title>, arXiv:2610.02690v2, 13 October 2026. <url href="https://arxiv.org/abs/2610.02690">Preprint</url>. Recent preprint; Theorem C is conditional on weak resolution.</biblio>
  <biblio xml:id="grf-bib-deligne" label="Del74" type="raw">Pierre Deligne, <title>Théorie de Hodge III</title>, Publications Mathématiques de l'IHÉS 44 (1974), 5–77. <url href="https://www.numdam.org/item/PMIHES_1974__44__5_0/">Article</url>. Mixed Hodge structures and their functorial formalism.</biblio>
  <biblio xml:id="grf-bib-joshi" label="Jos26" type="raw">Kirti Joshi, <title>On the Grothendieck ring of varieties in positive characteristic</title>, arXiv:1811.02614v3, 11 May 2026. <url href="https://arxiv.org/abs/1811.02614">Preprint and versions</url>. Its smooth-complete Bittner-relations ring is distinguished here from the ordinary scissors ring.</biblio>
  <biblio xml:id="grf-bib-mccrory-parusinski" label="MP03" type="raw">Clint McCrory and Adam Parusiński, <title>Virtual Betti numbers of real algebraic varieties</title>, Comptes Rendus Mathématique 336 (2003), 763–768. <url href="https://arxiv.org/abs/math/0210374">Preprint</url>.</biblio>
  <biblio xml:id="grf-bib-nicaise" label="Nic11" type="raw">Johannes Nicaise, <title>A trace formula for varieties over a discretely valued field</title>, Journal für die reine und angewandte Mathematik 650 (2011), 193–238. <url href="https://arxiv.org/abs/0805.1323">Preprint</url>. Proposition 2.9 gives the colimit statement used for spreading relations.</biblio>
  <biblio xml:id="grf-bib-nicaise-sebag" label="NS09" type="raw">Johannes Nicaise and Julien Sebag, <title>A note on motivic integration in mixed characteristic</title>, arXiv:0912.4887v1, 24 December 2009. <url href="https://arxiv.org/abs/0912.4887">Preprint</url>. Definition 3.2, Propositions 3.1 and 3.3, and Proposition 4.1.</biblio>
  <biblio xml:id="grf-bib-sga45" label="SGA4half" type="raw">Pierre Deligne, <title>Cohomologie étale (SGA 4½)</title>, Lecture Notes in Mathematics 569, Springer, 1977. <url href="https://doi.org/10.1007/BFb0091516">Book</url>. Compact support finiteness, localization, and Künneth formalism.</biblio>
  <biblio xml:id="grf-bib-litt" label="Lit15" type="raw">Daniel Litt, <title>Zeta functions of curves with no rational points</title>, Michigan Mathematical Journal 64 (2015), no. 2, 383–395. <url href="https://doi.org/10.1307/mmj/1434731929">DOI</url>; <url href="https://arxiv.org/abs/1405.7380">preprint</url>. Theorem 10, Theorem 24, and Proposition 27 are numbered as in arXiv:1405.7380v1, 28 May 2014.</biblio>
</references>
