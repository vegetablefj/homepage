{
  "files.associations": {
    "*.ptx": "pretext"
  },
  "task.saveBeforeRun": "always",
  "pretext-tools.pythonPath": "D:\\homepage\\.venv\\Scripts\\python.exe",
  "pretext-tools.installPretext": false,
  "pretext-tools.viewMethod": "Live Preview",
  "pretext-tools.instantPreview.scope": "file",
  "pretext-tools.instantPreview.autoRefresh": true,
  "pretext-tools.instantPreview.followActiveEditor": true,
  "pretext-tools.instantPreview.updateWhileTyping": false,
  "pretext-tools.paste.autoConvert": false,
  "[pretext]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "search.exclude": {
    ".build/**": true,
    ".cache/**": true,
    ".venv/**": true,
    "notes/**": true,
    "_static/**": true,
    "vendor/**": true
  }
}
