<?xml version="1.0" encoding="UTF-8"?>
<publication>
  <source><directories generated="../generated-assets"/></source>
  <common><chunking level="2"/><tableofcontents level="5"/></common>
  <numbering>
    <divisions level="5" part-structure="decorative"/>
    <blocks level="2"/><equations level="2"/><footnotes level="2"/>
  </numbering>
  <html read-aloud="no" favicon="none">
    <css theme="default-modern" palette="blue-red" provide-dark-mode="no"/>
    <platform host="web" portable="no"/><resources host="local"/>
    <index-page ref="hyperkahler-syz-notes"/>
    <search variant="textbook"/><annotation platform="none"/>
    <cross-references knowled="maximum"/>
    <knowl theorem="no" proof="yes" definition="no" example="no" remark="no" figure="no" table="no" list="no"/>
    <navigation logic="linear" upbutton="yes"/>
    <tableofcontents focused="yes" preexpanded-levels="2"/>
  </html>
</publication>
